FROM --platform=linux/amd64 python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y bash gcc libpq-dev curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# ── Layer 1: heavy/slow wheels cached separately to survive timeouts ──────────
RUN pip install --no-cache-dir --timeout=120 --retries=5 \
    psycopg2-binary==2.9.10 \
    SQLAlchemy==2.0.36 \
    cryptography==43.0.3 \
    pillow \
    reportlab \
    aiohttp \
    uvloop \
    locust==2.32.3

# ── Layer 2: remaining dependencies ──────────────────────────────────────────
RUN pip install --no-cache-dir --timeout=120 --retries=5 -r requirements.txt

# ── Chromium for Lead Hunter's Google Maps scraper ─────────────────────────
# `playwright install --with-deps chromium` (Playwright's own downloaded
# browser + its OS-dependency installer script) fails on this base image:
# the installer's hardcoded package list assumes an older Debian/Ubuntu
# and references packages (ttf-ubuntu-font-family, ttf-unifont) that were
# renamed/removed on this image's Debian release. Installing Debian's own
# `chromium` package instead sidesteps that entirely — apt resolves the
# correct dependency set for whatever this exact base image actually is,
# no hardcoded/stale package list to go stale again on a future rebuild.
# lead_hunter.py points Playwright at this binary via executable_path
# rather than Playwright's own downloaded copy. Must run as root, before
# the USER directive below drops privileges.
RUN apt-get update && apt-get install -y --no-install-recommends chromium \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Create beat schedule directory
RUN mkdir -p /var/celery

RUN useradd -m -u 1000 vitar \
    && chown -R vitar:vitar /app \
    && chown -R vitar:vitar /var/celery
USER vitar

# Default: run general worker. Override CMD for beat scheduler.
CMD ["celery", "-A", "app.workers.celery_app", "worker", \
     "--loglevel=info", \
     "--queues=notifications,reminders,ai,billing,celery,dead_letter", \
     "--concurrency=4", \
     "--max-tasks-per-child=500", \
     "--hostname=worker@%h"]

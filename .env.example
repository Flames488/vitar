# =============================================================================
# Vitar v11 — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the values before running the app.
# Never commit .env to version control.
#
# List fields (ALLOWED_ORIGINS, ALLOWED_HOSTS) accept three formats:
#   JSON array:        ALLOWED_ORIGINS='["https://a.com","https://b.com"]'
#   Comma-separated:  ALLOWED_ORIGINS=https://a.com,https://b.com
#   Single value:     ALLOWED_ORIGINS=https://a.com
# =============================================================================

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=Vitar
# Options: development | staging | production
ENVIRONMENT=development
# Generate with: openssl rand -hex 32
SECRET_KEY=

DEBUG=false

# ── 1-slice pilot tier only (docker-compose.prod-free.yml) ───────────────────
# Not needed if you're running the full docker-compose.prod.yml stack.
DOMAIN=livevault.cloud
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
FLOWER_USER=admin
FLOWER_PASSWORD=
# Gunicorn/uvicorn worker processes for the API container. Set to your VPS's
# vCPU count (4 for a 4-slice InterServer VPS). If unset, defaults to 4 — but
# don't rely on the default; set it explicitly so it's obvious at a glance.
UVICORN_WORKERS=4

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose default — change password in production
DATABASE_URL=postgresql://vitar:vitar@postgres:5432/vitar
POSTGRES_PASSWORD=vitar
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=25
# Hard per-query timeout (milliseconds)
DB_STATEMENT_TIMEOUT_MS=30000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30


# These should already be in your .env — confirm them:
MIGRATION_DATABASE_URL=postgresql://vitar:vitar@postgres:5432/vitar


# ── CORS / Hosts ──────────────────────────────────────────────────────────────
# Production: set to your real domain(s)
# Dev default includes localhost:5173 (Vite dev server) — fine for local use
# Fix 9: Set this to the exact Wabizz production domain(s). No wildcards.
# Do NOT add *.workers.dev — it covers all Cloudflare Workers, not just Wabizz.
# Production example:  ALLOWED_ORIGINS=["https://app.wabizz.com"]
# Local dev example:   ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_ORIGINS=["http://localhost","http://localhost:3002","http://localhost:5173","http://127.0.0.1:5173","https://livevault.cloud","https://www.livevault.cloud","https://app.livevault.cloud","https://api.livevault.cloud"]
# "api" (bare, no domain) must stay in this list — the Telegram ops bot
# (Phase 7) calls http://api:8000/... over the internal docker network,
# bypassing nginx entirely, so its Host header is "api" not a domain name.
ALLOWED_HOSTS=["localhost","127.0.0.1","api","livevault.cloud","www.livevault.cloud","app.livevault.cloud","api.livevault.cloud"]

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://livevault.cloud
VITE_API_URL=/api/v1

# ── Bot protection (Cloudflare Turnstile) ─────────────────────────────────────
# Site key is public, baked into the frontend build. Secret key is backend-only
# — never commit a real value here, only ever set it in the server's real .env.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# SECURITY: main.py enables /api/v1/docs + /api/v1/openapi.json whenever
# `API_DOCS_ENABLED OR ENVIRONMENT != "production"` — API_DOCS_ENABLED=true
# on its own overrides the production check and publishes the full Swagger
# UI + OpenAPI schema (every endpoint, including admin/Wabizz routes)
# publicly. Code default is already False; keep it False here too so a
# production deploy that copies this file doesn't opt back in by accident.
# Flip to true only temporarily, on a non-production environment.
API_DOCS_ENABLED=false

# ── Payment (at least one required in production) ─────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhook payloads with an HMAC-SHA512 of your SECRET KEY, so
# set this to the SAME value as PAYSTACK_SECRET_KEY (sk_live_...). If it is
# blank the /webhooks/paystack endpoint rejects every event and automatic
# clinic payouts will not be created from the webhook.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://app.livevault.cloud/settings/billing
PAYSTACK_WEBHOOK_URL=https://api.livevault.cloud/api/v1/webhooks/paystack
PAYSTACK_BASE_URL=https://api.paystack.co
# Minutes Vitar holds a clinic's share after a patient's payment clears
# before auto-transferring it to the clinic's bank. The transfer is
# dispatched immediately on payment (not batched); this is just a safety
# window for patient cancellations. 0 = no hold.
PAYOUT_AUTO_SEND_AFTER_MINUTES=15

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
# At least one SMS provider recommended
TERMII_API_KEY=
TERMII_SENDER_ID=Vitar

TWILIO_ACCOUNT_SID=S
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19784901237

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Web push (notify_new_booking in push_tasks.py) — without these, push
# notifications are silently skipped and only the email fallback fires.
# Generate a key pair with the py-vapid/pywebpush tooling already used by
# push_service.py. VAPID_CLAIMS_EMAIL defaults to vitarhealthcare@gmail.com
# in code if left unset here.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=

# Required for transactional email (registration, password reset)
SENDGRID_API_KEY=
EMAIL_FROM=vitarhealthcare@gmail.com
EMAIL_FROM_NAME=Vitar Health

# ── AI / ML ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=
ML_MODEL_PATH=/app/ml_models

# ── Monitoring ────────────────────────────────────────────────────────────────
# Optional but strongly recommended in production
SENTRY_DSN=

# ── Geo / Currency ────────────────────────────────────────────────────────────
IPAPI_KEY=
EXCHANGE_RATE_API_KEY=

# ── Trial limits ──────────────────────────────────────────────────────────────
TRIAL_DAYS=30
TRIAL_MAX_BOOKINGS=50
TRIAL_MAX_DOCTORS=2

# ── Storage ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vitar-uploads
AWS_REGION=us-east-1
STORAGE_BACKEND=local
ALLOW_LOCAL_UPLOADS_IN_PRODUCTION=true
UPLOAD_DIR=/app/uploads

# ── Observability dashboards ──────────────────────────────────────────────────
# CHANGE these in production — defaults are rejected by startup validation
FLOWER_USER=admin
FLOWER_PASSWORD=
GRAFANA_USER=admin
GRAFANA_PASSWORD=
SLOW_QUERY_THRESHOLD_S=0.5


OWNER_BANK_NAME=Example Bank
OWNER_ACCOUNT_NUMBER=0000000000
OWNER_ACCOUNT_NAME=Jane Doe


OWNER_BANK_NAME_2=OPay
OWNER_ACCOUNT_NUMBER_2=0000000000
OWNER_ACCOUNT_NAME_2=Jane Doe

# ── Alerts ────────────────────────────────────────────────────────────────────
# Optional: Slack incoming webhook URL for ops alerts
SLACK_WEBHOOK_URL=
PROMETHEUS_URL=http://prometheus:9090

# ── System resource thresholds ────────────────────────────────────────────────
CPU_ALERT_THRESHOLD_PCT=85.0
CPU_CRITICAL_THRESHOLD_PCT=95.0
MEMORY_ALERT_THRESHOLD_PCT=80.0
MEMORY_CRITICAL_THRESHOLD_PCT=90.0
DISK_ALERT_THRESHOLD_PCT=80.0
DISK_CRITICAL_THRESHOLD_PCT=92.0
DISK_CHECK_PATH=/

# ── Background job safety ─────────────────────────────────────────────────────
TASK_STUCK_THRESHOLD_S=600
AUTOHEAL_STUCK_TASKS=false

# ── AI Core (Lead Hunter / Sales / Content / Customer Success agents) ─────────
# Kill switch: false pauses all four agent Celery tasks instantly (no scrape,
# no AI call, no DB write) — flip via .env + `docker compose up -d --force-recreate
# beat worker telegram_bot` if something misbehaves, no redeploy needed.
AI_CORE_ENABLED=true
# Cross-cutting test flag: when true, every agent's external/irreversible
# action (Lead Hunter's scrape, Sales Agent's send) is stubbed and logged
# instead of actually happening, while the internal tables still populate
# normally end-to-end. Always wins over WABIZZ_OUTREACH_ENABLED below.
DRY_RUN=false
# Lead Hunter's Playwright scraper proxy. Leave empty until you have a real
# rotating proxy pool — see docs/ai-core.md before scaling scrape volume.
SCRAPER_PROXY_URL=

# Sales Agent's WhatsApp send, routed through Wabizz (getwabizz.com), not a
# direct Meta Cloud API integration. Keep false until Wabizz's security audit
# is closed AND you've manually verified one real send + reply round-trip.
WABIZZ_OUTREACH_ENABLED=false
WABIZZ_API_BASE=https://wabizz-app.emmyflames48.workers.dev
WABIZZ_API_KEY=
# Shared secret Wabizz must send back on its inbound-reply webhook
# (POST /api/v1/webhooks/wabizz-reply).
WABIZZ_WEBHOOK_SECRET=

# Telegram ops bot (Phase 7) — a bot created via @BotFather dedicated to
# Vitar ops, separate from any other Telegram bot/token in use elsewhere.
# Restricts every command to this single admin's Telegram user ID (get
# yours from @userinfobot). Leave both empty to not run the bot at all.
VITAR_TELEGRAM_BOT_TOKEN=
VITAR_ADMIN_TELEGRAM_ID=

# ── AI Core: geographic outreach targeting ───────────────────────────────────
# Lead Hunter and Sales Agent work outward from home. OUTREACH_PRIORITY_AREAS
# is an ORDERED comma-separated list — earliest = closest to you = hunted and
# messaged first. Most days hunt_leads_daily works one of these areas inside
# OUTREACH_HOME_CITY; ~1 day per cycle it hunts an OUTREACH_OTHER_CITIES city.
# Plain comma strings here (not JSON).
OUTREACH_HOME_CITY=Enugu
OUTREACH_PRIORITY_AREAS=Gariki,Awkunanaw,Agbani Road,Uwani,Achara Layout,Coal Camp,New Haven,Ogui,Asata,Independence Layout,GRA,Trans-Ekulu,Abakpa,Emene,Nsukka
OUTREACH_OTHER_CITIES=Lagos,Abuja,Port Harcourt,Ibadan
# Of every OUTREACH_DAILY_CYCLE_LENGTH daily runs, how many stay in the home
# city. 6 of 7 ≈ one "other city" day per week. Set HOME_CITY_DAYS_PER_CYCLE
# equal to CYCLE_LENGTH to never leave the home city.
OUTREACH_HOME_CITY_DAYS_PER_CYCLE=6
OUTREACH_DAILY_CYCLE_LENGTH=7

# ── Autoscaling (Docker Swarm / custom orchestration) ─────────────────────────
AUTOSCALE_ENABLED=false
AUTOSCALE_DRY_RUN=true
WORKER_MIN_REPLICAS=1
WORKER_MAX_REPLICAS=8
WORKER_SCALE_UP_QUEUE_DEPTH=100
WORKER_SCALE_DOWN_QUEUE_DEPTH=20
API_MIN_REPLICAS=1
API_MAX_REPLICAS=6
API_SCALE_UP_RPS=50.0
API_SCALE_DOWN_RPS=10.0

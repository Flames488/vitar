# =============================================================================
# Vitar — Local Dev .env (Supabase-backed)
# =============================================================================
# Copy this to .env and fill in your Supabase credentials.
# This file is for LOCAL TESTING only — do not use in production.
#
# How to get your Supabase credentials:
#   1. Go to https://supabase.com and create a free project
#   2. Go to Project Settings → Database
#   3. Copy the connection string from "Connection string" → URI mode
#      It looks like: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   4. Fill in the values below from that string
# =============================================================================

# ── Supabase Database ─────────────────────────────────────────────────────────
# Full direct connection URL (used by Alembic migrations — bypasses pgbouncer)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Individual parts (used by pgbouncer service in docker-compose.local.yml)
SUPABASE_DB_HOST=db.YOUR_REF.supabase.co
SUPABASE_DB_PASSWORD=YOUR_PASSWORD

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Vitar
ENVIRONMENT=development
DEBUG=true

# Generate with: openssl rand -hex 32
# On Windows PowerShell: -join ((1..32) | ForEach { '{0:x2}' -f (Get-Random -Max 256) })
SECRET_KEY=generate-a-random-hex-32-string-here
JWT_SECRET_KEY=generate-a-different-random-hex-32-string-here

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis (runs locally in Docker) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS / Hosts ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost","http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
FRONTEND_URL=http://localhost
VITE_API_URL=/api/v1

# ── Payment ───────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost/settings/billing
PAYSTACK_WEBHOOK_URL=http://localhost/api/v1/billing/webhook/paystack
PAYSTACK_BASE_URL=https://api.paystack.co

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Vitar

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=vitarhealthcare@gmail.com
EMAIL_FROM_NAME=Vitar Health

# ── Analytics ─────────────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
ML_MODEL_PATH=/app/ml_models

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Geo / Currency ────────────────────────────────────────────────────────────
IPAPI_KEY=
EXCHANGE_RATE_API_KEY=

# ── Trial limits ──────────────────────────────────────────────────────────────
TRIAL_DAYS=30
TRIAL_MAX_BOOKINGS=50
TRIAL_MAX_DOCTORS=2

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# ── Flower ────────────────────────────────────────────────────────────────────
# Access Flower at: http://localhost/flower
FLOWER_USER=admin
FLOWER_PASSWORD=vitar_flower_dev

# ── Owner bank details (for manual payment instructions) ─────────────────────
OWNER_BANK_NAME=Example Bank
OWNER_ACCOUNT_NUMBER=0000000000
OWNER_ACCOUNT_NAME=Jane Doe

OWNER_BANK_NAME_2=OPay
OWNER_ACCOUNT_NUMBER_2=0000000000
OWNER_ACCOUNT_NAME_2=Jane Doe

# ── PgBouncer ─────────────────────────────────────────────────────────────────
PGBOUNCER_ENABLED=true
PGBOUNCER_URL=postgresql://postgres:${SUPABASE_DB_PASSWORD}@pgbouncer:5432/postgres

# ── Background job safety ─────────────────────────────────────────────────────
TASK_STUCK_THRESHOLD_S=600
AUTOHEAL_STUCK_TASKS=false
